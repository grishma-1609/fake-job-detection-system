# =======================================================
# Intelligent Fake Job Detection System - Environment Config
# =======================================================

# Application Environment (development, testing, production)
APP_ENV=production

# Server Port (Render sets this dynamically via $PORT)
PORT=10000

# Secret Key for cryptographic session signing (generate a random 32-char hex string)
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-key

# Streamlit Configuration
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLE_CORS=false
STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=true

# Database Configuration (Defaults to local JSON data store)
# In future PostgreSQL migrations, set DATABASE_URL=postgresql://user:password@host:port/dbname
DATABASE_TYPE=json
